# Copy to .env (never commit .env)

# --- Target to scan (CareNote demo). Use the SESSION POOLER string from Supabase → Connect (port 5432).
DEMO_DB_URL=postgresql://postgres.<demo_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DEMO_SUPABASE_URL=https://<demo_ref>.supabase.co
DEMO_SERVICE_ROLE_KEY=

# Default DB for `redrow scan` when --db is omitted
REDROW_DB_URL=

# Optional: DB for the rollback safety test
REDROW_TEST_DB_URL=

# --- HQ (dashboard project, connected to Sodabase)
HQ_DB_URL=postgresql://postgres.<hq_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
HQ_SUPABASE_URL=https://<hq_ref>.supabase.co
HQ_ANON_KEY=
HQ_SERVICE_ROLE_KEY=
REDROW_INGEST_URL=https://<hq_ref>.supabase.co/functions/v1/ingest
REDROW_INGEST_KEY=
HQ_DB_PASSWORD=
# The same value goes in the sweep function's SWEEP_TOKEN secret and in Vault as sweep_token.
HQ_SWEEP_TOKEN=

# --- AI (optional; scan works without it)
ANTHROPIC_API_KEY=
REDROW_MODEL=claude-sonnet-5-5
