{
  "name": "redrow-monorepo",
  "private": true,
  "type": "module",
  "description": "AI wrote your RLS. Red Row proves whether it leaks.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "hq"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build -w @redrow/engine && npm run build -w redrow",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "scan": "node packages/cli/dist/index.js scan",
    "fix": "node packages/cli/dist/index.js fix",
    "demo:reset": "node demo-target/scripts/apply.mjs demo-target/supabase/reset.sql demo-target/supabase/leaky.sql && node demo-target/scripts/seed.mjs",
    "demo:fix-reference": "node demo-target/scripts/apply.mjs demo-target/supabase/fixed.sql",
    "sync:engine": "npm run build -w @redrow/engine && node scripts/sync-engine.mjs",
    "sync:web": "node scripts/sync-web-data.mjs",
    "demo:capture-fixed": "node demo-target/scripts/capture-fixed-reference.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
